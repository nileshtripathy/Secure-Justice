PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/securejustice

# REQUIRED. At least 16 random characters, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=my_secret_key
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173
# Set to true to also accept any https://*.vercel.app origin (preview deployments)
ALLOW_VERCEL_PREVIEWS=false

# Email (for OTP). Use a Gmail App Password.
# If left empty in development, OTPs are printed to the backend console instead.
EMAIL_USER=
EMAIL_PASS=

# Used only by `npm run seed:admin` / `npm run seed:judge`
ADMIN_EMAIL=
ADMIN_PASSWORD=
